# =============================================================================
# 唯一配置文件：改这里即可适配自己的 WSL2 + 公网 frp + SSH 跑 CUDA
# 路径：.cursor/skills/skill-install-wsl2/config.env
# 脚本全部 source / 解析本文件，不要把 IP、端口、token 再散落到别处。
# =============================================================================

# --- Windows / WSL ---
WSL_DISTRO=pmpp-ubuntu
# WSL SSH 默认用 root（发行版虽有 ubuntu 用户，不要用它登录）
WSL_USER=root
WSL_SSH_PORT=22
PMPP_ROOT=<repo>/pmpp-4th
WSL_VHDX_DIR=<repo>/pmpp-4th/wsl-ubuntu
WSL_ROOTFS_CACHE=<repo>/pmpp-4th/.cache
WSL_ROOTFS_URL=https://cloud-images.ubuntu.com/wsl/releases/noble/current/ubuntu-noble-wsl-amd64-wsl.rootfs.tar.gz

# 空闲超时（毫秒）。不要设 -1。Windows 只在登录时挂一次 `wsl ... wsl-host-hold.sh`（bash sleep）；
# frpc/sshd 由 WSL 里 systemd 保活，不要用计划任务轮询 wsl.exe。
WSL_VM_IDLE_TIMEOUT=2592000000
WSL_AUTO_PROXY=false
WSL_LOCALHOST_FORWARDING=true

# --- 公网入口（轻量/ECS，跑 frps）---
FRP_SERVER_ADDR=YOUR.PUBLIC.IP
FRP_SERVER_SSH_USER=root
FRP_SERVER_SSH_PORT=22
FRP_SERVER_SSH_IDENTITY=~/.ssh/id_ed25519_frps
FRP_SERVER_SSH_HOST_ALIAS=frps-host

# frp 版本与二进制（中国区 VPS/WSL 直连 GitHub 经常超时，必须在能翻墙的 Windows 上下再 scp）
FRP_VERSION=0.71.0
FRP_TARBALL_NAME=frp_0.71.0_linux_amd64.tar.gz

# 控制面端口（阿里云防火墙要放行 TCP）
FRP_BIND_PORT=7000
# 外地 SSH 打到公网的这个端口，再转到 WSL:22（不要占用服务器自己的 22）
FRP_SSH_REMOTE_PORT=60022
# 仅本机回环，给健康检查用，不要对公网开放
FRP_ADMIN_PORT=7400
FRP_PROXY_NAME=wsl-ssh

# 自己生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
# 不要提交真实 token 到 git
FRP_TOKEN=CHANGE_ME_GENERATE_A_TOKEN

# 吞吐优先：关 mux/压缩/加密。SSH 跑 CUDA、scp/rsync 模型时压缩会更慢更易卡
FRP_TCP_MUX=false
FRP_USE_COMPRESSION=false
FRP_USE_ENCRYPTION=false
FRP_POOL_COUNT=1
FRP_HEARTBEAT_INTERVAL=10
FRP_HEARTBEAT_TIMEOUT=30
FRP_DIAL_TIMEOUT=10
FRP_LOGIN_FAIL_EXIT=false

# --- 外地 SSH 客户端 ---
SSH_HOST_ALIAS=wsl-gpu
SSH_IDENTITY=~/.ssh/id_ed25519
# 写入 WSL authorized_keys；留空则 apply-wsl.sh 不改密钥
SSH_PUBKEY=
# 不要开 Compression。大文件/模型走压缩会吃 CPU 且更慢
SSH_COMPRESSION=no
SSH_SERVER_ALIVE_INTERVAL=15
SSH_SERVER_ALIVE_COUNT_MAX=8
SSH_IPQOS=throughput
SSH_CONFIG_PATH=~/.ssh/config

# 已废弃：Windows 不再轮询。间隔只给 WSL 内 frpc-healthcheck.timer 用。
WATCHDOG_INTERVAL_SEC=20
HEALTHCHECK_INTERVAL_SEC=30
